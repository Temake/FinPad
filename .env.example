# FinPad Environment Configuration
# Copy this file to .env and update values

# === App ===
APP_NAME=FinPad
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# === API ===
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# === Database ===
DATABASE_URL=postgresql+asyncpg://finpad:finpad@localhost:5432/finpad

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === JWT Auth ===
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# === OTP ===
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# === Evolution API (WhatsApp) ===
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE=finpad-main
EVOLUTION_API_GLOBAL_KEY=
EVOLUTION_API_KEY=change-me

# === SMS Fallback (Termii) ===
# Sign up at https://termii.com to get API key
TERMII_API_KEY=
TERMII_SENDER_ID=FinPad

# === S3 / Object Storage ===
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=finpad-receipts

# === AI / Gemini ===
# Get API key at https://aistudio.google.com/
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash
